APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unispot
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unispot_test
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_MINUTES=10080
ALLOWED_ORIGINS=["http://localhost:5173"]
