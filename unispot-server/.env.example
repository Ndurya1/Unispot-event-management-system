# Database (required)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Auth (required)
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Frontend base used to build email verification/reset links
FRONTEND_URL=http://localhost:5173

# Transactional email via Resend (https://resend.com). Leave RESEND_API_KEY unset in
# development to print verification/reset links to the backend server logs instead.
RESEND_API_KEY=
EMAIL_FROM=UniSpot <onboarding@resend.dev>

# Auth email token TTLs (minutes)
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
