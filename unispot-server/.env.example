APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unispot
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unispot_test
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_MINUTES=10080
ALLOWED_ORIGINS=["http://localhost:5173"]

# Request safety (limits are per socket IP and group, shared through PostgreSQL)
MAX_REQUEST_BODY_BYTES=32768
REQUEST_BODY_TIMEOUT_SECONDS=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_BOOKING=30
RATE_LIMIT_AVAILABILITY=60
RATE_LIMIT_ASSISTANT=20
ASSISTANT_TIMEOUT_SECONDS=20
WORKER_INTERVAL_SECONDS=30

# Optional future model provider; intentionally disabled until the backend
# adapter and dependency are enabled. Never commit a real key.
# GEMINI_API_KEY=replace-with-your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-flash
