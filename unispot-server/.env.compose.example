# Copy to .env.compose (gitignored). These placeholders are not deployment secrets.
APP_ENV=development
POSTGRES_DB=unispot
POSTGRES_USER=unispot
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Match POSTGRES_PASSWORD above; URL-encode special characters in the URL password.
DATABASE_URL=postgresql+asyncpg://unispot:replace-with-a-random-database-password@postgres:5432/unispot
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=["http://localhost:5173"]

# Optional future model provider; intentionally disabled until the backend
# adapter and dependency are enabled. Never commit a real key.
# GEMINI_API_KEY=replace-with-your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-flash
